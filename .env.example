# Application Meta (developers.facebook.com)
META_APP_ID=votre_app_id
META_APP_SECRET=votre_app_secret
META_GRAPH_VERSION=v23.0
# auto : graph.instagram.com pour les tokens « connexion Instagram business », graph.facebook.com pour les tokens Facebook
META_API=auto

# Clé de chiffrement des tokens (générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Secret de session pour le dashboard
SESSION_SECRET=changez_moi

# Base de données (SQLite par défaut, PostgreSQL recommandé en production)
DATABASE_URL=sqlite:///./igmanager.db

# Compte admin initial (créé au premier démarrage)
ADMIN_EMAIL=admin@parti.fr
ADMIN_PASSWORD=changez_moi_immediatement

# Cookies de session uniquement en HTTPS (mettre 1 en production, derriere nginx)
HTTPS_ONLY=0

# Banque de posts : connexion kDrive (Infomaniak). Token API à créer dans le Manager Infomaniak
# (Mon profil > Tokens API, périmètre « drive »). L'identifiant du kDrive est dans son URL.
KDRIVE_TOKEN=
KDRIVE_DRIVE_ID=
# Dossier kDrive contenant les visuels (1 = racine ; l'identifiant d'un dossier est dans son URL)
KDRIVE_FOLDER_ID=1
# Adresse publique de l'app (les médias importés sont servis sous /static/media/) ; Meta doit pouvoir la joindre
PUBLIC_BASE_URL=http://localhost:8000
# Dépôt des visuels déclinés sur kDrive avec liens publics (écriture) : 0 = jamais, 1 = autorisé
KDRIVE_ECRITURE=0
# Dossier kDrive de dépôt des visuels publics (identifiant du dossier)
KDRIVE_PUBLIC_FOLDER_ID=
